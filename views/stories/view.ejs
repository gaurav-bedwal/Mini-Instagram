<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <title>Story - Blogs</title>
  <%- include('../partials/common-styles') %>
    <style>
      body {
        background: #000;
        margin: 0;
        overflow: hidden;
      }

      .story-viewer {
        width: 100vw;
        height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        position: relative;
      }

      .story-content {
        max-width: 420px;
        width: 100%;
        height: 100%;
        max-height: 90vh;
        position: relative;
        background: #1a1a1a;
        border-radius: 12px;
        overflow: hidden;
      }

      .story-header {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        padding: 16px;
        background: linear-gradient(to bottom, rgba(0, 0, 0, 0.6), transparent);
        z-index: 10;
        display: flex;
        align-items: center;
        gap: 12px;
      }

      .story-avatar {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        object-fit: cover;
        border: 2px solid white;
      }

      .story-user-info {
        flex: 1;
        color: white;
      }

      .story-username {
        font-weight: 600;
        font-size: 14px;
      }

      .story-time {
        font-size: 12px;
        opacity: 0.8;
      }

      .close-btn {
        width: 36px;
        height: 36px;
        background: rgba(255, 255, 255, 0.2);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        text-decoration: none;
      }

      .story-media {
        width: 100%;
        height: 100%;
        object-fit: contain;
      }

      .story-caption {
        position: absolute;
        bottom: 80px;
        left: 16px;
        right: 16px;
        color: white;
        text-shadow: 0 1px 2px rgba(0, 0, 0, 0.5);
        font-size: 14px;
        line-height: 1.4;
      }

      .story-footer {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        padding: 16px;
        background: linear-gradient(to top, rgba(0, 0, 0, 0.6), transparent);
        display: flex;
        gap: 8px;
        align-items: center;
      }

      .reply-input {
        flex: 1;
        padding: 12px 16px;
        border-radius: 22px;
        border: 1px solid rgba(255, 255, 255, 0.3);
        background: transparent;
        color: white;
        font-size: 14px;
        outline: none;
      }

      .reply-input::placeholder {
        color: rgba(255, 255, 255, 0.6);
      }

      .delete-story-btn {
        flex: 1;
        padding: 12px 16px;
        border-radius: 22px;
        border: 1px solid rgba(255, 255, 255, 0.3);
        background: rgba(220, 38, 38, 0.4);
        color: white;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        transition: background 0.2s;
      }

      .delete-story-btn:hover {
        background: rgba(220, 38, 38, 0.6);
      }

      .reaction-btns {
        display: flex;
        gap: 8px;
      }

      .reaction-btn {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.2);
        border: none;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
      }

      .progress-bar-container {
        position: absolute;
        top: 8px;
        left: 16px;
        right: 16px;
        display: flex;
        gap: 4px;
        z-index: 11;
      }

      .progress-bar {
        flex: 1;
        height: 3px;
        background: rgba(255, 255, 255, 0.3);
        border-radius: 2px;
        overflow: hidden;
      }

      .progress-bar-fill {
        height: 100%;
        background: white;
        width: 0%;
        animation: progress 10s linear forwards;
      }

      @keyframes progress {
        to {
          width: 100%;
        }
      }

      .nav-area {
        position: absolute;
        top: 60px;
        bottom: 80px;
        width: 30%;
        z-index: 5;
        cursor: pointer;
      }

      .nav-area.prev {
        left: 0;
      }

      .nav-area.next {
        right: 0;
      }

      .viewers-count {
        position: absolute;
        bottom: 80px;
        left: 16px;
        color: white;
        font-size: 13px;
        display: flex;
        align-items: center;
        gap: 6px;
      }

      .close-friends-badge {
        position: absolute;
        top: 60px;
        right: 16px;
        background: #44b700;
        color: white;
        padding: 4px 8px;
        border-radius: 4px;
        font-size: 11px;
        font-weight: 600;
      }

      .avatar-placeholder {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: #efefef;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        color: #8e8e8e;
        border: 2px solid white;
      }
    </style>
</head>

<body>
  <div class="story-viewer">
    <div class="story-content">
      <div class="progress-bar-container">
        <div class="progress-bar">
          <div class="progress-bar-fill" id="progressFill"></div>
        </div>
      </div>

      <div class="story-header">
        <% if (story.user.avatar) { %>
          <img src="<%= story.user.avatar %>" class="story-avatar" alt="<%= story.user.username %>">
          <% } else { %>
            <div class="avatar-placeholder">
              <%= story.user.username.charAt(0).toUpperCase() %>
            </div>
            <% } %>
              <div class="story-user-info">
                <div class="story-username">
                  <%= story.user.username %>
                </div>
                <div class="story-time">
                  <% const timeDiff=Date.now() - new Date(story.createdAt); const hours=Math.floor(timeDiff / 3600000);
                    const minutes=Math.floor(timeDiff / 60000); %>
                    <%= hours> 0 ? hours + 'h ago' : minutes + 'm ago' %>
                </div>
              </div>
              <a href="/stories" class="close-btn">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
                  <line x1="18" y1="6" x2="6" y2="18"></line>
                  <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
              </a>
      </div>

      <% if (story.closeFriendsOnly) { %>
        <div class="close-friends-badge">Close Friends</div>
        <% } %>

          <img src="<%= story.media %>" class="story-media" alt="Story">

          <% if (story.caption) { %>
            <div class="story-caption">
              <%= story.caption %>
            </div>
            <% } %>

              <% if (story.user._id.toString()===user._id.toString()) { %>
                <div class="viewers-count">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="white">
                    <path
                      d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z" />
                  </svg>
                  <%= story.views ? story.views.length : 0 %> views
                </div>
                <% } %>

                  <div class="story-footer">
                    <% if (story.user._id.toString()===user._id.toString()) { %>
                      <button class="delete-story-btn" onclick="deleteStory()">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                          stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M3 6h18"></path>
                          <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2">
                          </path>
                          <line x1="10" y1="11" x2="10" y2="17"></line>
                          <line x1="14" y1="11" x2="14" y2="17"></line>
                        </svg>
                        Delete Story
                      </button>
                      <% } else { %>
                        <input type="text" class="reply-input" placeholder="Send a message..." id="replyInput">
                        <div class="reaction-btns">
                          <button class="reaction-btn" onclick="react('❤️')">❤️</button>
                          <button class="reaction-btn" onclick="react('🔥')">🔥</button>
                          <button class="reaction-btn" onclick="react('😂')">😂</button>
                        </div>
                        <% } %>
                  </div>

                  <div class="nav-area prev" onclick="prevStory()"></div>
                  <div class="nav-area next" onclick="nextStory()"></div>
    </div>
  </div>

  <script>
    const storyId = '<%= story._id %>';

    // Auto-close after animation
    document.getElementById('progressFill').addEventListener('animationend', function () {
      window.location.href = '/stories';
    });

    // Pause on hold
    let isPaused = false;
    document.querySelector('.story-content').addEventListener('mousedown', function () {
      isPaused = true;
      document.getElementById('progressFill').style.animationPlayState = 'paused';
    });
    document.querySelector('.story-content').addEventListener('mouseup', function () {
      isPaused = false;
      document.getElementById('progressFill').style.animationPlayState = 'running';
    });

    async function react(emoji) {
      try {
        await fetch(`/stories/${storyId}/react`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ emoji })
        });
        // Show brief feedback
        const btn = event.target;
        btn.style.transform = 'scale(1.3)';
        setTimeout(() => { btn.style.transform = 'scale(1)'; }, 200);
      } catch (err) {
        console.error('React error:', err);
      }
    }

    function prevStory() {
      // Go back to stories list
      window.location.href = '/stories';
    }

    function nextStory() {
      // Go to next story or back to list
      window.location.href = '/stories';
    }

    // Handle reply
    const replyInput = document.getElementById('replyInput');
    if (replyInput) {
      replyInput.addEventListener('keypress', async function (e) {
        if (e.key === 'Enter' && this.value.trim()) {
          try {
            // Send as DM to story owner
            window.location.href = `/messages/conversation/<%= story.user._id %>`;
          } catch (err) {
            console.error('Reply error:', err);
          }
        }
      });
    }

    async function deleteStory() {
      if (!confirm('Are you sure you want to delete this story?')) return;

      try {
        const res = await fetch(`/stories/${storyId}`, {
          method: 'DELETE'
        });
        const data = await res.json();
        if (data.success) {
          window.location.href = '/stories';
        } else {
          alert(data.error || 'Failed to delete story');
        }
      } catch (err) {
        console.error('Delete error:', err);
        alert('Failed to delete story');
      }
    }
  </script>
</body>

</html>