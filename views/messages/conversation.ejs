<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Chat with <%= otherUser.username %> - Blogs</title>
  <%- include('../partials/common-styles') %>
  <style>
    .chat-container {
      max-width: 700px;
      margin: 0 auto;
      height: calc(100vh - 80px);
      display: flex;
      flex-direction: column;
      background: var(--bg-color, white);
    }
    .chat-header {
      display: flex;
      align-items: center;
      padding: 16px;
      border-bottom: 1px solid var(--border-color, #dbdbdb);
      gap: 12px;
    }
    .back-btn {
      padding: 8px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      text-decoration: none;
      color: inherit;
    }
    .back-btn:hover {
      background: var(--hover-color, #fafafa);
    }
    .chat-avatar {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      object-fit: cover;
    }
    .chat-user-info h3 {
      margin: 0;
      font-size: 16px;
    }
    .chat-user-info span {
      font-size: 12px;
      color: #8e8e8e;
    }
    .online-status {
      color: #44b700;
    }
    .messages-area {
      flex: 1;
      overflow-y: auto;
      padding: 16px;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .message {
      max-width: 70%;
      padding: 10px 14px;
      border-radius: 18px;
      font-size: 14px;
      line-height: 1.4;
    }
    .message.sent {
      background: #0095f6;
      color: white;
      align-self: flex-end;
      border-bottom-right-radius: 4px;
    }
    .message.received {
      background: var(--message-bg, #efefef);
      color: var(--text-color, #262626);
      align-self: flex-start;
      border-bottom-left-radius: 4px;
    }
    .message-time {
      font-size: 11px;
      opacity: 0.7;
      margin-top: 4px;
    }
    .message-input-area {
      padding: 16px;
      border-top: 1px solid var(--border-color, #dbdbdb);
      display: flex;
      gap: 12px;
      align-items: center;
    }
    .message-input {
      flex: 1;
      padding: 12px 16px;
      border: 1px solid var(--border-color, #dbdbdb);
      border-radius: 22px;
      font-size: 14px;
      outline: none;
      background: var(--input-bg, #fafafa);
    }
    .message-input:focus {
      border-color: #0095f6;
    }
    .send-btn {
      padding: 10px 20px;
      background: #0095f6;
      color: white;
      border: none;
      border-radius: 20px;
      font-weight: 600;
      cursor: pointer;
    }
    .send-btn:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }
    .date-separator {
      text-align: center;
      color: #8e8e8e;
      font-size: 12px;
      padding: 16px 0;
    }
    .empty-chat {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      color: #8e8e8e;
    }
    .avatar-placeholder {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      background: #efefef;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 18px;
      color: #8e8e8e;
    }
  </style>
</head>
<body>
  <%- include('../partials/sidebar') %>
  <%- include('../partials/mobile-nav') %>

  <div class="main-content">
    <div class="chat-container">
      <div class="chat-header">
        <a href="/messages" class="back-btn">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M19 12H5M12 19l-7-7 7-7"/>
          </svg>
        </a>
        <% if (otherUser.avatar) { %>
          <img src="<%= otherUser.avatar %>" class="chat-avatar" alt="<%= otherUser.username %>">
        <% } else { %>
          <div class="avatar-placeholder"><%= otherUser.username.charAt(0).toUpperCase() %></div>
        <% } %>
        <div class="chat-user-info">
          <h3><%= otherUser.username %></h3>
          <span class="<%= otherUser.isOnline ? 'online-status' : '' %>">
            <%= otherUser.isOnline ? 'Active now' : 'Offline' %>
          </span>
        </div>
        <a href="/user/<%= otherUser._id %>" style="margin-left:auto; color:#0095f6; text-decoration:none; font-size:14px;">View Profile</a>
      </div>

      <div class="messages-area" id="messagesArea">
        <% if (conversation.messages.length === 0) { %>
          <div class="empty-chat">
            <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="margin-bottom:16px;opacity:0.5;">
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
            </svg>
            <p>No messages yet. Say hello!</p>
          </div>
        <% } else { %>
          <% 
            let lastDate = null;
            conversation.messages.forEach((msg, index) => {
              const msgDate = new Date(msg.createdAt).toDateString();
              const showDate = lastDate !== msgDate;
              lastDate = msgDate;
              const isSent = (msg.sender._id || msg.sender).toString() === user._id.toString();
          %>
            <% if (showDate) { %>
              <div class="date-separator"><%= new Date(msg.createdAt).toLocaleDateString('en-US', { weekday: 'long', month: 'short', day: 'numeric' }) %></div>
            <% } %>
            <div class="message <%= isSent ? 'sent' : 'received' %>">
              <%= msg.content %>
              <div class="message-time">
                <%= new Date(msg.createdAt).toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' }) %>
              </div>
            </div>
          <% }) %>
        <% } %>
      </div>

      <div class="message-input-area">
        <input type="text" class="message-input" id="messageInput" placeholder="Message..." onkeypress="if(event.key==='Enter')sendMessage()">
        <button class="send-btn" onclick="sendMessage()">Send</button>
      </div>
    </div>
  </div>

  <%- include('../partials/scripts') %>
  <script>
    const conversationId = '<%= conversation._id %>';
    const messagesArea = document.getElementById('messagesArea');
    
    // Scroll to bottom on load
    messagesArea.scrollTop = messagesArea.scrollHeight;

    async function sendMessage() {
      const input = document.getElementById('messageInput');
      const content = input.value.trim();
      
      if (!content) return;
      
      input.value = '';
      
      // Optimistically add message
      const msgDiv = document.createElement('div');
      msgDiv.className = 'message sent';
      msgDiv.innerHTML = `
        ${content}
        <div class="message-time">Just now</div>
      `;
      messagesArea.appendChild(msgDiv);
      messagesArea.scrollTop = messagesArea.scrollHeight;
      
      try {
        const res = await fetch(`/messages/send/${conversationId}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ content })
        });
        
        if (!res.ok) {
          msgDiv.style.opacity = '0.5';
          msgDiv.innerHTML += '<br><small style="color:#ed4956;">Failed to send</small>';
        }
      } catch (err) {
        console.error('Send error:', err);
        msgDiv.style.opacity = '0.5';
      }
    }

    // Poll for new messages every 5 seconds
    setInterval(async () => {
      try {
        const res = await fetch(`/messages/conversation/<%= otherUser._id %>`, {
          headers: { 'Accept': 'application/json' }
        });
        const data = await res.json();
        
        // Check if there are new messages
        if (data.conversation.messages.length > messagesArea.querySelectorAll('.message').length) {
          // Reload the page to show new messages (simple approach)
          location.reload();
        }
      } catch (err) {
        console.error('Poll error:', err);
      }
    }, 5000);
  </script>
</body>
</html>
