<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Request Verification - Blogs</title>
  <%- include('partials/common-styles') %>
  <style>
    .verify-container {
      max-width: 550px;
      margin: 0 auto;
      padding: 30px 20px;
    }
    
    .verify-header {
      text-align: center;
      margin-bottom: 32px;
    }
    
    .verify-badge {
      width: 80px;
      height: 80px;
      margin: 0 auto 16px;
      background: linear-gradient(135deg, #405de6, #5851db, #833ab4, #c13584, #e1306c);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    
    .verify-badge svg {
      color: white;
    }
    
    .verify-header h1 {
      font-size: 24px;
      font-weight: 600;
      margin: 0 0 8px 0;
    }
    
    .verify-header p {
      color: var(--color-text-secondary);
      font-size: 14px;
      margin: 0;
      max-width: 400px;
      margin: 0 auto;
    }
    
    .verify-form {
      background: var(--color-bg-primary);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-lg);
      padding: 24px;
    }
    
    .form-section {
      margin-bottom: 24px;
    }
    
    .form-section:last-child {
      margin-bottom: 0;
    }
    
    .form-section-title {
      font-weight: 600;
      font-size: 16px;
      margin-bottom: 16px;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    
    .form-section-title span {
      background: var(--color-bg-secondary);
      color: var(--color-text-secondary);
      font-size: 12px;
      padding: 2px 8px;
      border-radius: var(--radius-sm);
      font-weight: 500;
    }
    
    .form-group {
      margin-bottom: 16px;
    }
    
    .form-group:last-child {
      margin-bottom: 0;
    }
    
    .form-group label {
      display: block;
      font-size: 14px;
      font-weight: 500;
      margin-bottom: 8px;
    }
    
    .form-group input,
    .form-group textarea,
    .form-group select {
      width: 100%;
      padding: 12px;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      font-size: 14px;
      background: var(--color-bg-secondary);
      color: var(--color-text-primary);
      transition: border-color 0.2s;
    }
    
    .form-group input:focus,
    .form-group textarea:focus,
    .form-group select:focus {
      outline: none;
      border-color: var(--color-primary);
    }
    
    .form-group textarea {
      min-height: 100px;
      resize: vertical;
    }
    
    .form-help {
      font-size: 12px;
      color: var(--color-text-secondary);
      margin-top: 6px;
    }
    
    .links-container {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    
    .link-input {
      display: flex;
      gap: 8px;
    }
    
    .link-input input {
      flex: 1;
    }
    
    .link-input button {
      padding: 0 12px;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      background: var(--color-bg-secondary);
      color: var(--color-text-secondary);
      cursor: pointer;
    }
    
    .add-link-btn {
      display: flex;
      align-items: center;
      gap: 4px;
      padding: 8px 12px;
      background: transparent;
      border: 1px dashed var(--color-border);
      border-radius: var(--radius-md);
      color: var(--color-primary);
      font-size: 14px;
      cursor: pointer;
      width: fit-content;
    }
    
    .file-upload {
      border: 2px dashed var(--color-border);
      border-radius: var(--radius-md);
      padding: 24px;
      text-align: center;
      cursor: pointer;
      transition: border-color 0.2s;
    }
    
    .file-upload:hover {
      border-color: var(--color-primary);
    }
    
    .file-upload input {
      display: none;
    }
    
    .file-upload svg {
      color: var(--color-text-secondary);
      margin-bottom: 8px;
    }
    
    .file-upload p {
      margin: 0;
      font-size: 14px;
      color: var(--color-text-secondary);
    }
    
    .file-upload .browse {
      color: var(--color-primary);
      font-weight: 500;
    }
    
    .file-preview {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px;
      background: var(--color-bg-secondary);
      border-radius: var(--radius-md);
      margin-top: 12px;
    }
    
    .file-preview img {
      width: 40px;
      height: 40px;
      object-fit: cover;
      border-radius: var(--radius-sm);
    }
    
    .file-preview .file-info {
      flex: 1;
    }
    
    .file-preview .file-name {
      font-size: 13px;
      font-weight: 500;
    }
    
    .file-preview .file-size {
      font-size: 12px;
      color: var(--color-text-secondary);
    }
    
    .file-preview .remove-file {
      padding: 4px;
      background: transparent;
      border: none;
      cursor: pointer;
      color: var(--color-text-secondary);
    }
    
    .submit-btn {
      width: 100%;
      padding: 14px;
      background: var(--color-primary);
      color: white;
      border: none;
      border-radius: var(--radius-md);
      font-size: 16px;
      font-weight: 600;
      cursor: pointer;
      transition: background 0.2s;
      margin-top: 16px;
    }
    
    .submit-btn:hover {
      background: #1877f2;
    }
    
    .submit-btn:disabled {
      background: #b0c4de;
      cursor: not-allowed;
    }
    
    .category-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 8px;
    }
    
    .category-option {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 12px;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      cursor: pointer;
      transition: all 0.2s;
    }
    
    .category-option:hover {
      border-color: var(--color-primary);
    }
    
    .category-option input {
      display: none;
    }
    
    .category-option input:checked + .category-content {
      color: var(--color-primary);
    }
    
    .category-option:has(input:checked) {
      border-color: var(--color-primary);
      background: rgba(0, 149, 246, 0.05);
    }
    
    .category-content {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 14px;
    }
    
    .already-verified {
      text-align: center;
      padding: 40px 20px;
    }
    
    .already-verified svg {
      color: #0095f6;
      margin-bottom: 16px;
    }
    
    .pending-notice {
      background: #fff3cd;
      border: 1px solid #ffc107;
      border-radius: var(--radius-md);
      padding: 16px;
      text-align: center;
      margin-bottom: 24px;
    }
    
    .pending-notice h3 {
      margin: 0 0 8px 0;
      color: #856404;
    }
    
    .pending-notice p {
      margin: 0;
      color: #856404;
      font-size: 14px;
    }
    
    @media (max-width: 480px) {
      .category-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>
<body>
  <%- include('partials/sidebar') %>
  <%- include('partials/modal') %>
  <%- include('partials/mobile-nav') %>

  <div class="main-content">
    <%- include('partials/top-nav') %>
    
    <div class="verify-container">
      <div class="verify-header">
        <div class="verify-badge">
          <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
          </svg>
        </div>
        <h1>Request Verification</h1>
        <p>The verified badge helps people find the real accounts of public figures, celebrities, and brands.</p>
      </div>
      
      <% if (user.isVerified) { %>
        <div class="already-verified">
          <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
          </svg>
          <h2>You're already verified!</h2>
          <p>Your account already has a verification badge.</p>
        </div>
      <% } else if (pendingRequest) { %>
        <div class="pending-notice">
          <h3>Request Pending</h3>
          <p>You already have a verification request under review. We'll notify you once a decision has been made.</p>
        </div>
      <% } else { %>
        <form class="verify-form" action="/verify/request" method="POST" enctype="multipart/form-data" id="verifyForm">
          <div class="form-section">
            <div class="form-section-title">Account Information</div>
            
            <div class="form-group">
              <label>Full Name / Organization Name</label>
              <input type="text" name="fullName" value="<%= user.name || '' %>" required placeholder="Your full legal name or business name">
            </div>
          </div>
          
          <div class="form-section">
            <div class="form-section-title">Category</div>
            
            <div class="category-grid">
              <label class="category-option">
                <input type="radio" name="category" value="creator" required>
                <div class="category-content">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M12 19l7-7 3 3-7 7-3-3z"></path>
                    <path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"></path>
                  </svg>
                  Creator
                </div>
              </label>
              
              <label class="category-option">
                <input type="radio" name="category" value="business" required>
                <div class="category-content">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                    <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                  </svg>
                  Business
                </div>
              </label>
              
              <label class="category-option">
                <input type="radio" name="category" value="entertainment" required>
                <div class="category-content">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polygon points="23 7 16 12 23 17 23 7"></polygon>
                    <rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect>
                  </svg>
                  Entertainment
                </div>
              </label>
              
              <label class="category-option">
                <input type="radio" name="category" value="sports" required>
                <div class="category-content">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"></circle>
                    <path d="M12 2v20M2 12h20"></path>
                  </svg>
                  Sports
                </div>
              </label>
              
              <label class="category-option">
                <input type="radio" name="category" value="government" required>
                <div class="category-content">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M3 21h18M3 10h18M5 6l7-3 7 3M4 10v11M20 10v11"></path>
                  </svg>
                  Government
                </div>
              </label>
              
              <label class="category-option">
                <input type="radio" name="category" value="media" required>
                <div class="category-content">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M4 11a9 9 0 0 1 9 9"></path>
                    <path d="M4 4a16 16 0 0 1 16 16"></path>
                    <circle cx="5" cy="19" r="1"></circle>
                  </svg>
                  Media
                </div>
              </label>
            </div>
          </div>
          
          <div class="form-section">
            <div class="form-section-title">
              Why should you be verified?
            </div>
            
            <div class="form-group">
              <label>Reason for Verification</label>
              <textarea name="reason" required placeholder="Explain why your account should be verified. Include details about your public presence, notability, and why verification is important for your audience."></textarea>
              <div class="form-help">Minimum 50 characters</div>
            </div>
          </div>
          
          <div class="form-section">
            <div class="form-section-title">
              Supporting Links
              <span>Optional</span>
            </div>
            
            <div class="links-container" id="linksContainer">
              <div class="link-input">
                <input type="url" name="links[]" placeholder="https://example.com/article-about-you">
              </div>
            </div>
            <button type="button" class="add-link-btn" onclick="addLinkField()">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
              </svg>
              Add another link
            </button>
            <div class="form-help" style="margin-top: 8px;">Add links to news articles, Wikipedia, official websites, etc.</div>
          </div>
          
          <div class="form-section">
            <div class="form-section-title">
              Identity Document
            </div>
            
            <label class="file-upload" id="fileUpload">
              <input type="file" name="idDocument" accept="image/*,.pdf" id="idDocInput">
              <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="17 8 12 3 7 8"></polyline>
                <line x1="12" y1="3" x2="12" y2="15"></line>
              </svg>
              <p>Click to upload or drag and drop</p>
              <p class="browse">Browse files</p>
            </label>
            <div id="filePreview"></div>
            <div class="form-help">Upload a government-issued ID (passport, driver's license, etc.) or official business document. This helps us confirm your identity.</div>
          </div>
          
          <button type="submit" class="submit-btn" id="submitBtn">Submit Verification Request</button>
        </form>
      <% } %>
    </div>
  </div>

  <%- include('partials/scripts') %>
  <script>
    const linksContainer = document.getElementById('linksContainer');
    let linkCount = 1;
    
    function addLinkField() {
      if (linkCount >= 5) {
        showToast('Maximum 5 links allowed');
        return;
      }
      
      const div = document.createElement('div');
      div.className = 'link-input';
      div.innerHTML = `
        <input type="url" name="links[]" placeholder="https://example.com/article-about-you">
        <button type="button" onclick="this.parentElement.remove(); linkCount--;">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      `;
      linksContainer.appendChild(div);
      linkCount++;
    }
    
    // File upload preview
    const idDocInput = document.getElementById('idDocInput');
    const fileUpload = document.getElementById('fileUpload');
    const filePreview = document.getElementById('filePreview');
    
    idDocInput?.addEventListener('change', function(e) {
      const file = e.target.files[0];
      if (file) {
        const fileSize = (file.size / 1024 / 1024).toFixed(2);
        if (fileSize > 10) {
          showToast('File size must be less than 10MB');
          idDocInput.value = '';
          return;
        }
        
        let preview = '';
        if (file.type.startsWith('image/')) {
          const reader = new FileReader();
          reader.onload = function(e) {
            filePreview.innerHTML = `
              <div class="file-preview">
                <img src="${e.target.result}" alt="Preview">
                <div class="file-info">
                  <div class="file-name">${file.name}</div>
                  <div class="file-size">${fileSize} MB</div>
                </div>
                <button type="button" class="remove-file" onclick="removeFile()">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                  </svg>
                </button>
              </div>
            `;
          };
          reader.readAsDataURL(file);
        } else {
          filePreview.innerHTML = `
            <div class="file-preview">
              <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
              </svg>
              <div class="file-info">
                <div class="file-name">${file.name}</div>
                <div class="file-size">${fileSize} MB</div>
              </div>
              <button type="button" class="remove-file" onclick="removeFile()">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <line x1="18" y1="6" x2="6" y2="18"></line>
                  <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
              </button>
            </div>
          `;
        }
        fileUpload.style.display = 'none';
      }
    });
    
    function removeFile() {
      idDocInput.value = '';
      filePreview.innerHTML = '';
      fileUpload.style.display = 'block';
    }
    
    // Form validation
    document.getElementById('verifyForm')?.addEventListener('submit', function(e) {
      const reason = this.querySelector('textarea[name="reason"]').value;
      if (reason.length < 50) {
        e.preventDefault();
        showToast('Please provide a more detailed reason (at least 50 characters)');
        return;
      }
      
      const category = this.querySelector('input[name="category"]:checked');
      if (!category) {
        e.preventDefault();
        showToast('Please select a category');
        return;
      }
      
      document.getElementById('submitBtn').disabled = true;
      document.getElementById('submitBtn').textContent = 'Submitting...';
    });
  </script>
</body>
</html>
