<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <title>Blogs</title>
  <%- include('partials/common-styles') %>
</head>

<body>

  <%- include('partials/sidebar') %>
    <%- include('partials/modal') %>
      <%- include('partials/mobile-nav') %>

        <div class="main-content">
          <%- include('partials/top-nav') %>

            <div class="posts-container" data-current-page="<%= currentPage %>" data-total-pages="<%= totalPages %>">
              <% if (posts.length===0) { %>
                <div class="empty-state" style="text-align: center; padding: 60px 20px; color: #8e8e8e;">
                  <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none"
                    stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
                    style="margin-bottom: 16px; opacity: 0.5;">
                    <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                    <circle cx="8.5" cy="8.5" r="1.5"></circle>
                    <polyline points="21 15 16 10 5 21"></polyline>
                  </svg>
                  <h3 style="margin: 0 0 8px 0; font-size: 18px; color: inherit;">No posts yet</h3>
                  <p style="margin: 0 0 20px 0;">Be the first to share something!</p>
                  <a href="/post/new"
                    style="display: inline-block; padding: 10px 24px; background: #0095f6; color: white; text-decoration: none; border-radius: 8px; font-weight: 600;">Create
                    Post</a>
                </div>
                <% } %>
                  <% posts.forEach(post=> { %>
                    <% const isLiked=post.likes && post.likes.some(id=> id.toString() === user._id.toString()); %>
                      <% const isSaved=user.savedPosts && user.savedPosts.some(id=> id.toString() ===
                        post._id.toString()); %>

                        <div class="post-card" data-post-id="<%= post._id %>">
                          <!-- Header -->
                          <div class="post-header">
                            <a href="/user/<%= post.user ? post.user._id : '' %>" class="user-info"
                              style="text-decoration: none; color: inherit;">
                              <% if (post.user && post.user.avatar) { %>
                                <img src="<%= post.user.avatar %>" alt="<%= post.user.username %>">
                                <% } else { %>
                                  <div
                                    style="width:32px; height:32px; background:#efefef; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:14px; color:#8e8e8e;">
                                    <%= post.user ? post.user.username.charAt(0).toUpperCase() : 'U' %>
                                  </div>
                                  <% } %>
                                    <strong>
                                      <%= post.user ? post.user.username : 'user' %>
                                    </strong>
                            </a>

                            <% if (post.user && post.user._id.toString()===user._id.toString()) { %>
                              <div style="position: relative;">
                                <div class="menu-dot" onclick="toggleMenu('menu-<%= post._id %>')">
                                  <svg aria-label="More options" fill="currentColor" height="24" viewBox="0 0 24 24"
                                    width="24">
                                    <circle cx="12" cy="12" r="1.5"></circle>
                                    <circle cx="6" cy="12" r="1.5"></circle>
                                    <circle cx="18" cy="12" r="1.5"></circle>
                                  </svg>
                                </div>
                                <div id="menu-<%= post._id %>" class="dropdown-menu">
                                  <a href="/post/<%= post._id %>/edit">Edit</a>
                                  <form method="POST" action="/post/<%= post._id %>/delete" style="margin: 0;">
                                    <button type="submit" class="delete-btn"
                                      style="color: #ed4956; font-weight: 600; width: 100%; text-align: left; padding: 12px 16px; background: none; border: none; cursor: pointer; font-size: 14px;">Delete</button>
                                  </form>
                                </div>
                              </div>
                              <% } %>
                          </div>

                          <!-- Image (with double-tap support) -->
                          <% if (post.image && post.image.length> 5) { %>
                            <div class="post-image-container" style="position: relative; cursor: pointer;">
                              <% if (post.mediaType==='video' ) { %>
                                <video src="<%= post.image %>" class="post-image" loading="lazy" controls loop
                                  style="object-fit: cover; width: 100%; height: 100%;"></video>
                                <% } else { %>
                                  <img src="<%= post.image %>" class="post-image" loading="lazy" alt="Post">
                                  <% } %>
                            </div>
                            <% } %>

                              <!-- Interaction & Actions -->
                              <div class="post-actions">
                                <div class="action-icons">
                                  <button type="button" class="action-btn like-btn"
                                    onclick="likePost('<%= post._id %>', this.closest('.post-card'))">
                                    <svg aria-label="Like" height="24" viewBox="0 0 24 24" width="24"
                                      fill="<%= isLiked ? '#ed4956' : 'none' %>"
                                      stroke="<%= isLiked ? '#ed4956' : 'currentColor' %>">
                                      <path
                                        d="M16.792 3.904A4.989 4.989 0 0121.5 9.122c0 3.072-2.652 4.959-5.197 7.222-2.512 2.243-3.865 3.469-4.303 3.752-.477-.309-2.143-1.823-4.303-3.752C5.141 14.077 2.5 12.194 2.5 9.122a4.989 4.989 0 014.708-5.218 4.21 4.21 0 013.675 1.941c.325.487.568 1.05.617 1.649.034.417.433.417.467 0a4.213 4.213 0 013.675-1.941 4.213 4.213 0 013.15 1.353z"
                                        stroke-width="2"></path>
                                    </svg>
                                  </button>
                                  <a href="/post/<%= post._id %>" class="action-btn" style="color: inherit;">
                                    <svg aria-label="Comment" height="24" viewBox="0 0 24 24" width="24">
                                      <path d="M20.656 17.008a9.993 9.993 0 10-3.59 3.615L22 22z" fill="none"
                                        stroke="currentColor" stroke-linejoin="round" stroke-width="2"></path>
                                    </svg>
                                  </a>
                                  <button type="button" class="action-btn save-btn <%= isSaved ? 'saved' : '' %>"
                                    onclick="savePost('<%= post._id %>', this)" style="margin-left: auto;">
                                    <svg aria-label="Save" height="24" viewBox="0 0 24 24" width="24"
                                      fill="<%= isSaved ? 'currentColor' : 'none' %>" stroke="currentColor"
                                      stroke-width="2">
                                      <path d="M19 21l-7-5-7 5V5a2 2 0 012-2h10a2 2 0 012 2z"></path>
                                    </svg>
                                  </button>
                                </div>

                                <div class="likes-count">
                                  <%= post.likes ? post.likes.length : 0 %> likes
                                </div>

                                <div class="post-caption">
                                  <b>
                                    <%= post.user ? post.user.username : 'user' %>
                                  </b>
                                  <%= post.caption %>
                                </div>

                                <% if (post.comments && post.comments.length> 0) { %>
                                  <a href="/post/<%= post._id %>" class="view-comments-btn">
                                    View all <%= post.comments.length %> comments
                                  </a>
                                  <% const lastC=post.comments[post.comments.length - 1]; %>
                                    <div class="latest-comment">
                                      <b>
                                        <%= lastC.username %>
                                      </b>
                                      <%= lastC.text %>
                                    </div>
                                    <% } %>
                              </div>

                              <!-- Inline Comment Form -->
                              <form method="POST" action="/post/<%= post._id %>/comment" class="comment-form">
                                <input type="text" name="comment" class="comment-input" placeholder="Add a comment..."
                                  required>
                                <button type="submit" class="comment-submit">Post</button>
                              </form>
                        </div>
                        <% }) %>
            </div>

            <!-- Loading indicator for infinite scroll -->
            <div id="loadingIndicator" style="display: none;" class="loading-spinner">
              <div class="spinner"></div>
            </div>
        </div>

        <%- include('partials/scripts') %>
</body>

</html>