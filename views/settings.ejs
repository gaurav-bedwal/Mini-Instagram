<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <title>Settings - Blogs</title>
  <%- include('partials/common-styles') %>
    <style>
      .settings-container {
        background: var(--card-bg, #fff);
        border: 1px solid var(--border-color, #dbdbdb);
        border-radius: 12px;
        padding: 40px;
        width: 100%;
        max-width: 700px;
        margin: 30px auto;
      }

      h2 {
        margin-top: 0;
        font-size: 24px;
        text-align: left;
        margin-bottom: 30px;
        color: var(--text-color, #262626);
      }

      .settings-tabs {
        display: flex;
        gap: 8px;
        margin-bottom: 24px;
        flex-wrap: wrap;
        border-bottom: 1px solid var(--border-color, #dbdbdb);
        padding-bottom: 16px;
      }

      .settings-tab {
        padding: 8px 16px;
        border-radius: 20px;
        background: transparent;
        border: none;
        cursor: pointer;
        font-size: 14px;
        font-weight: 600;
        color: var(--text-secondary, #8e8e8e);
      }

      .settings-tab.active {
        background: var(--tab-active-bg, #efefef);
        color: var(--text-color, #262626);
      }

      .settings-section {
        display: none;
      }

      .settings-section.active {
        display: block;
      }

      .section-title {
        font-size: 16px;
        font-weight: 600;
        margin: 24px 0 16px;
        color: var(--text-color, #262626);
      }

      .form-group {
        display: grid;
        grid-template-columns: 140px 1fr;
        align-items: center;
        margin-bottom: 20px;
        gap: 20px;
      }

      label {
        font-weight: 600;
        font-size: 14px;
        color: var(--text-color, #262626);
        text-align: right;
      }

      input[type="text"],
      input[type="email"],
      input[type="url"],
      textarea,
      select {
        width: 100%;
        padding: 10px 12px;
        border: 1px solid var(--border-color, #dbdbdb);
        border-radius: 6px;
        font-size: 14px;
        background: var(--input-bg, #fafafa);
        box-sizing: border-box;
        transition: border-color 0.2s;
        color: var(--text-color, #262626);
      }

      input:focus, textarea:focus, select:focus {
        border-color: #0095f6;
        outline: none;
      }

      .avatar-section {
        display: flex;
        align-items: center;
        gap: 20px;
        margin-bottom: 30px;
      }

      .avatar-preview {
        width: 72px;
        height: 72px;
        border-radius: 50%;
        object-fit: cover;
      }

      .avatar-info {
        display: flex;
        flex-direction: column;
        gap: 4px;
      }

      .avatar-info b {
        font-size: 18px;
      }

      .change-photo-btn {
        color: #0095f6;
        font-weight: 600;
        font-size: 14px;
        cursor: pointer;
        padding: 0;
        background: none;
        border: none;
      }

      .submit-btn {
        background-color: #0095f6;
        color: white;
        border: none;
        padding: 10px 24px;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        font-size: 14px;
        margin-top: 16px;
      }

      .submit-btn:hover {
        background-color: #0084db;
      }

      .toggle-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 16px 0;
        border-bottom: 1px solid var(--border-color, #dbdbdb);
      }

      .toggle-info {
        flex: 1;
      }

      .toggle-info h4 {
        margin: 0 0 4px;
        font-size: 14px;
        font-weight: 600;
      }

      .toggle-info p {
        margin: 0;
        font-size: 12px;
        color: #8e8e8e;
      }

      .toggle-switch {
        position: relative;
        width: 48px;
        height: 28px;
      }

      .toggle-switch input {
        opacity: 0;
        width: 0;
        height: 0;
      }

      .toggle-slider {
        position: absolute;
        cursor: pointer;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: #ccc;
        border-radius: 28px;
        transition: 0.3s;
      }

      .toggle-slider:before {
        position: absolute;
        content: "";
        height: 22px;
        width: 22px;
        left: 3px;
        bottom: 3px;
        background-color: white;
        border-radius: 50%;
        transition: 0.3s;
      }

      .toggle-switch input:checked + .toggle-slider {
        background-color: #0095f6;
      }

      .toggle-switch input:checked + .toggle-slider:before {
        transform: translateX(20px);
      }

      .danger-zone {
        margin-top: 32px;
        padding-top: 24px;
        border-top: 1px solid var(--border-color, #dbdbdb);
      }

      .danger-btn {
        background: #ed4956;
        color: white;
        border: none;
        padding: 10px 24px;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        font-size: 14px;
      }

      .social-links-grid {
        display: grid;
        gap: 12px;
      }

      .social-input {
        display: flex;
        align-items: center;
        gap: 8px;
      }

      .social-input span {
        width: 80px;
        font-size: 13px;
        color: #8e8e8e;
      }

      .social-input input {
        flex: 1;
      }

      .blocked-user-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px 0;
        border-bottom: 1px solid var(--border-color, #dbdbdb);
      }

      .blocked-user-info {
        display: flex;
        align-items: center;
        gap: 12px;
      }

      .blocked-avatar {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        object-fit: cover;
      }

      .unblock-btn {
        padding: 6px 12px;
        background: transparent;
        border: 1px solid var(--border-color, #dbdbdb);
        border-radius: 6px;
        color: var(--text-color, #262626);
        cursor: pointer;
        font-size: 13px;
        font-weight: 600;
      }

      @media (max-width: 768px) {
        .settings-container {
          padding: 20px;
          border: none;
          margin: 0;
          background: none;
        }

        .form-group {
          grid-template-columns: 1fr;
          gap: 5px;
        }

        label {
          text-align: left;
        }

        .submit-btn {
          width: 100%;
        }

        .avatar-section {
          padding-left: 0;
        }
      }

      /* Dark Mode */
      body.dark-mode .settings-container {
        background-color: #121212 !important;
        border-color: #333 !important;
      }

      body.dark-mode h2,
      body.dark-mode label,
      body.dark-mode .avatar-info b,
      body.dark-mode .toggle-info h4 {
        color: #fff !important;
      }

      body.dark-mode input,
      body.dark-mode textarea,
      body.dark-mode select {
        background: #000 !important;
        border-color: #333 !important;
        color: #fff !important;
      }

      body.dark-mode .settings-tab.active {
        background: #333 !important;
        color: #fff !important;
      }
    </style>
</head>

<body>
  <%- include('partials/sidebar') %>
    <%- include('partials/modal') %>
      <%- include('partials/mobile-nav') %>

        <div class="main-content">
          <%- include('partials/top-nav') %>

            <div class="settings-container">
              <h2>Settings</h2>

              <div class="settings-tabs">
                <button class="settings-tab active" onclick="showSection('profile')">Edit Profile</button>
                <button class="settings-tab" onclick="showSection('privacy')">Privacy</button>
                <button class="settings-tab" onclick="showSection('notifications')">Notifications</button>
                <button class="settings-tab" onclick="showSection('security')">Security</button>
                <button class="settings-tab" onclick="showSection('appearance')">Appearance</button>
              </div>

              <!-- Profile Section -->
              <div class="settings-section active" id="section-profile">
                <form method="POST" action="/settings" enctype="multipart/form-data">
                  <input type="hidden" name="section" value="profile">

                  <div class="avatar-section">
                    <% if (user.avatar) { %>
                      <img src="<%= user.avatar %>" class="avatar-preview" id="previewImg">
                    <% } else { %>
                      <div style="width: 72px; height: 72px; border-radius: 50%; background: #efefef; display:flex; align-items:center; justify-content:center; font-size:28px; color:#8e8e8e;"
                        class="avatar-preview" id="previewImg"><%= user.username.charAt(0).toUpperCase() %></div>
                    <% } %>
                    <div class="avatar-info">
                      <b><%= user.username %></b>
                      <label for="avatarInput" class="change-photo-btn">Change profile photo</label>
                      <input type="file" id="avatarInput" name="avatar" accept="image/*" style="display: none;"
                        onchange="previewFile()">
                    </div>
                  </div>

                  <div class="form-group">
                    <label>Name</label>
                    <input type="text" name="name" value="<%= user.name || '' %>" placeholder="Full Name">
                  </div>

                  <div class="form-group">
                    <label>Username</label>
                    <input type="text" name="username" value="<%= user.username %>" required>
                  </div>

                  <div class="form-group">
                    <label>Bio</label>
                    <textarea name="bio" rows="3" placeholder="Tell us about yourself..."><%= user.bio || '' %></textarea>
                  </div>

                  <div class="form-group">
                    <label>Email</label>
                    <input type="email" name="email" value="<%= user.email %>" required>
                  </div>

                  <div class="form-group">
                    <label>Website</label>
                    <input type="url" name="website" value="<%= user.website || '' %>" placeholder="https://yourwebsite.com">
                  </div>

                  <div class="section-title">Social Links</div>
                  <div class="social-links-grid">
                    <div class="social-input">
                      <span>Twitter</span>
                      <input type="text" name="socialLinks[twitter]" value="<%= user.socialLinks?.twitter || '' %>" placeholder="@username">
                    </div>
                    <div class="social-input">
                      <span>Instagram</span>
                      <input type="text" name="socialLinks[instagram]" value="<%= user.socialLinks?.instagram || '' %>" placeholder="@username">
                    </div>
                    <div class="social-input">
                      <span>YouTube</span>
                      <input type="url" name="socialLinks[youtube]" value="<%= user.socialLinks?.youtube || '' %>" placeholder="Channel URL">
                    </div>
                    <div class="social-input">
                      <span>LinkedIn</span>
                      <input type="url" name="socialLinks[linkedin]" value="<%= user.socialLinks?.linkedin || '' %>" placeholder="Profile URL">
                    </div>
                  </div>

                  <button type="submit" class="submit-btn">Save Profile</button>
                </form>
              </div>

              <!-- Privacy Section -->
              <div class="settings-section" id="section-privacy">
                <form method="POST" action="/settings/privacy">
                  <div class="toggle-row">
                    <div class="toggle-info">
                      <h4>Private Account</h4>
                      <p>Only approved followers can see your posts</p>
                    </div>
                    <label class="toggle-switch">
                      <input type="checkbox" name="isPrivate" <%= user.isPrivate ? 'checked' : '' %>>
                      <span class="toggle-slider"></span>
                    </label>
                  </div>

                  <div class="toggle-row">
                    <div class="toggle-info">
                      <h4>Show Activity Status</h4>
                      <p>Let others see when you're active</p>
                    </div>
                    <label class="toggle-switch">
                      <input type="checkbox" name="showActivityStatus" <%= user.showActivityStatus !== false ? 'checked' : '' %>>
                      <span class="toggle-slider"></span>
                    </label>
                  </div>

                  <div class="toggle-row">
                    <div class="toggle-info">
                      <h4>Allow Tags</h4>
                      <p>Let others tag you in posts</p>
                    </div>
                    <label class="toggle-switch">
                      <input type="checkbox" name="allowTags" <%= user.allowTags !== false ? 'checked' : '' %>>
                      <span class="toggle-slider"></span>
                    </label>
                  </div>

                  <button type="submit" class="submit-btn">Save Privacy Settings</button>
                </form>

                <div class="section-title" style="margin-top:32px;">Blocked Users</div>
                <% if (user.blockedUsers && user.blockedUsers.length > 0) { %>
                  <% user.blockedUsers.forEach(blocked => { %>
                    <div class="blocked-user-item">
                      <div class="blocked-user-info">
                        <div style="width:44px;height:44px;border-radius:50%;background:#efefef;display:flex;align-items:center;justify-content:center;">?</div>
                        <span>Blocked User</span>
                      </div>
                      <button class="unblock-btn" onclick="unblockUser('<%= blocked %>')">Unblock</button>
                    </div>
                  <% }) %>
                <% } else { %>
                  <p style="color:#8e8e8e;font-size:14px;">You haven't blocked anyone.</p>
                <% } %>
              </div>

              <!-- Notifications Section -->
              <div class="settings-section" id="section-notifications">
                <form method="POST" action="/settings/notifications">
                  <div class="toggle-row">
                    <div class="toggle-info">
                      <h4>Push Notifications</h4>
                      <p>Receive push notifications</p>
                    </div>
                    <label class="toggle-switch">
                      <input type="checkbox" name="pushEnabled" <%= user.notificationSettings?.pushEnabled !== false ? 'checked' : '' %>>
                      <span class="toggle-slider"></span>
                    </label>
                  </div>

                  <div class="toggle-row">
                    <div class="toggle-info">
                      <h4>Email Notifications</h4>
                      <p>Receive email notifications</p>
                    </div>
                    <label class="toggle-switch">
                      <input type="checkbox" name="emailEnabled" <%= user.notificationSettings?.emailEnabled !== false ? 'checked' : '' %>>
                      <span class="toggle-slider"></span>
                    </label>
                  </div>

                  <div class="toggle-row">
                    <div class="toggle-info">
                      <h4>Likes</h4>
                      <p>When someone likes your post</p>
                    </div>
                    <label class="toggle-switch">
                      <input type="checkbox" name="likes" <%= user.notificationSettings?.likes !== false ? 'checked' : '' %>>
                      <span class="toggle-slider"></span>
                    </label>
                  </div>

                  <div class="toggle-row">
                    <div class="toggle-info">
                      <h4>Comments</h4>
                      <p>When someone comments on your post</p>
                    </div>
                    <label class="toggle-switch">
                      <input type="checkbox" name="comments" <%= user.notificationSettings?.comments !== false ? 'checked' : '' %>>
                      <span class="toggle-slider"></span>
                    </label>
                  </div>

                  <div class="toggle-row">
                    <div class="toggle-info">
                      <h4>New Followers</h4>
                      <p>When someone follows you</p>
                    </div>
                    <label class="toggle-switch">
                      <input type="checkbox" name="follows" <%= user.notificationSettings?.follows !== false ? 'checked' : '' %>>
                      <span class="toggle-slider"></span>
                    </label>
                  </div>

                  <div class="toggle-row">
                    <div class="toggle-info">
                      <h4>Direct Messages</h4>
                      <p>When you receive a message</p>
                    </div>
                    <label class="toggle-switch">
                      <input type="checkbox" name="messages" <%= user.notificationSettings?.messages !== false ? 'checked' : '' %>>
                      <span class="toggle-slider"></span>
                    </label>
                  </div>

                  <button type="submit" class="submit-btn">Save Notification Settings</button>
                </form>
              </div>

              <!-- Security Section -->
              <div class="settings-section" id="section-security">
                <div class="section-title">Change Password</div>
                <form method="POST" action="/settings/password">
                  <div class="form-group">
                    <label>Current</label>
                    <input type="password" name="currentPassword" required>
                  </div>
                  <div class="form-group">
                    <label>New</label>
                    <input type="password" name="newPassword" required minlength="6">
                  </div>
                  <div class="form-group">
                    <label>Confirm</label>
                    <input type="password" name="confirmPassword" required minlength="6">
                  </div>
                  <button type="submit" class="submit-btn">Change Password</button>
                </form>

                <div class="section-title" style="margin-top:32px;">Two-Factor Authentication</div>
                <div class="toggle-row">
                  <div class="toggle-info">
                    <h4>Enable 2FA</h4>
                    <p>Add an extra layer of security to your account</p>
                  </div>
                  <label class="toggle-switch">
                    <input type="checkbox" name="twoFactorEnabled" <%= user.twoFactorEnabled ? 'checked' : '' %> onchange="toggle2FA(this)">
                    <span class="toggle-slider"></span>
                  </label>
                </div>

                <div class="section-title" style="margin-top:32px;">Login History</div>
                <p style="color:#8e8e8e;font-size:14px;">Recent login activity on your account.</p>
                <% if (user.loginHistory && user.loginHistory.length > 0) { %>
                  <% user.loginHistory.slice(0, 5).forEach(login => { %>
                    <div style="padding:12px 0; border-bottom:1px solid var(--border-color, #dbdbdb); font-size:14px;">
                      <div><strong><%= login.device || 'Unknown device' %></strong></div>
                      <div style="color:#8e8e8e;font-size:12px;">
                        <%= new Date(login.timestamp).toLocaleString() %> - <%= login.ip || 'Unknown IP' %>
                      </div>
                    </div>
                  <% }) %>
                <% } else { %>
                  <p style="color:#8e8e8e;font-size:14px;">No login history available.</p>
                <% } %>

                <div class="danger-zone">
                  <div class="section-title" style="color:#ed4956;">Danger Zone</div>
                  <p style="color:#8e8e8e;font-size:14px;margin-bottom:16px;">Once you delete your account, there is no going back.</p>
                  <button class="danger-btn" onclick="confirmDeleteAccount()">Delete Account</button>
                </div>
              </div>

              <!-- Appearance Section -->
              <div class="settings-section" id="section-appearance">
                <div class="section-title">Theme</div>
                <div class="toggle-row">
                  <div class="toggle-info">
                    <h4>Dark Mode</h4>
                    <p>Switch between light and dark themes</p>
                  </div>
                  <label class="toggle-switch">
                    <input type="checkbox" id="darkModeToggle" onchange="toggleThemeFromSettings()">
                    <span class="toggle-slider"></span>
                  </label>
                </div>

                <div class="section-title" style="margin-top:32px;">Quick Links</div>
                <div style="display:flex;flex-direction:column;gap:12px;">
                  <a href="/activity" style="display:flex;align-items:center;gap:12px;padding:12px;border:1px solid var(--border-color,#dbdbdb);border-radius:8px;text-decoration:none;color:inherit;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                    <div>
                      <strong>Login Activity</strong>
                      <div style="font-size:12px;color:#8e8e8e;">View your recent login history</div>
                    </div>
                  </a>
                  <a href="/verify/request" style="display:flex;align-items:center;gap:12px;padding:12px;border:1px solid var(--border-color,#dbdbdb);border-radius:8px;text-decoration:none;color:inherit;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="#0095f6"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
                    <div>
                      <strong>Request Verification</strong>
                      <div style="font-size:12px;color:#8e8e8e;">Apply for a verified badge</div>
                    </div>
                  </a>
                  <a href="/suggested" style="display:flex;align-items:center;gap:12px;padding:12px;border:1px solid var(--border-color,#dbdbdb);border-radius:8px;text-decoration:none;color:inherit;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="8.5" cy="7" r="4"></circle><line x1="20" y1="8" x2="20" y2="14"></line><line x1="23" y1="11" x2="17" y2="11"></line></svg>
                    <div>
                      <strong>Suggested Users</strong>
                      <div style="font-size:12px;color:#8e8e8e;">People you may know</div>
                    </div>
                  </a>
                </div>
              </div>
            </div>
        </div>

        <script>
          function showSection(name) {
            // Hide all sections
            document.querySelectorAll('.settings-section').forEach(s => s.classList.remove('active'));
            document.querySelectorAll('.settings-tab').forEach(t => t.classList.remove('active'));
            
            // Show selected section
            document.getElementById('section-' + name).classList.add('active');
            event.target.classList.add('active');
          }

          function previewFile() {
            const preview = document.getElementById('previewImg');
            const file = document.querySelector('input[type=file]').files[0];
            const reader = new FileReader();

            reader.onloadend = function () {
              if (preview.tagName === 'IMG') {
                preview.src = reader.result;
              } else {
                // Replace div with img
                const img = document.createElement('img');
                img.src = reader.result;
                img.className = 'avatar-preview';
                img.id = 'previewImg';
                preview.parentNode.replaceChild(img, preview);
              }
            }

            if (file) {
              reader.readAsDataURL(file);
            }
          }

          async function unblockUser(userId) {
            if (!confirm('Unblock this user?')) return;
            
            try {
              const res = await fetch(`/user/${userId}/unblock`, { method: 'POST' });
              if (res.ok) {
                location.reload();
              } else {
                alert('Failed to unblock user');
              }
            } catch (err) {
              alert('Failed to unblock user');
            }
          }

          async function toggle2FA(checkbox) {
            const enable = checkbox.checked;
            
            if (enable) {
              alert('2FA setup coming soon! This feature requires additional configuration.');
              checkbox.checked = false;
            } else {
              if (confirm('Disable two-factor authentication?')) {
                try {
                  const res = await fetch('/settings/2fa/disable', { method: 'POST' });
                  if (!res.ok) {
                    checkbox.checked = true;
                    alert('Failed to disable 2FA');
                  }
                } catch (err) {
                  checkbox.checked = true;
                  alert('Failed to disable 2FA');
                }
              } else {
                checkbox.checked = true;
              }
            }
          }

          function confirmDeleteAccount() {
            if (confirm('Are you sure you want to delete your account? This action cannot be undone.')) {
              if (confirm('This will permanently delete all your posts, comments, and data. Type "DELETE" to confirm.')) {
                const input = prompt('Type DELETE to confirm:');
                if (input === 'DELETE') {
                  fetch('/settings/delete-account', { method: 'POST' })
                    .then(res => {
                      if (res.ok) {
                        window.location.href = '/login';
                      } else {
                        alert('Failed to delete account');
                      }
                    });
                }
              }
            }
          }

          function toggleThemeFromSettings() {
            const isDark = document.body.classList.toggle('dark-mode');
            localStorage.setItem('theme', isDark ? 'dark' : 'light');
            document.getElementById('darkModeToggle').checked = isDark;
          }

          // Initialize dark mode toggle state on page load
          document.addEventListener('DOMContentLoaded', function() {
            const darkModeToggle = document.getElementById('darkModeToggle');
            if (darkModeToggle) {
              darkModeToggle.checked = document.body.classList.contains('dark-mode');
            }
          });
        </script>
        <%- include('partials/scripts') %>
</body>

</html>