<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Suggested For You - Blogs</title>
  <%- include('partials/common-styles') %>
  <style>
    .suggested-container {
      max-width: 600px;
      margin: 0 auto;
      padding: 30px 20px;
    }
    
    .page-header {
      margin-bottom: 24px;
    }
    
    .page-header h1 {
      font-size: 24px;
      font-weight: 600;
      margin: 0 0 8px 0;
    }
    
    .page-header p {
      color: var(--color-text-secondary);
      font-size: 14px;
      margin: 0;
    }
    
    .suggested-list {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    
    .user-card {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 16px;
      background: var(--color-bg-primary);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      transition: background 0.2s;
    }
    
    .user-card:hover {
      background: var(--color-bg-secondary);
    }
    
    .user-avatar {
      width: 56px;
      height: 56px;
      border-radius: 50%;
      object-fit: cover;
      flex-shrink: 0;
    }
    
    .avatar-placeholder {
      width: 56px;
      height: 56px;
      border-radius: 50%;
      background: #efefef;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 24px;
      color: #8e8e8e;
      flex-shrink: 0;
    }
    
    .user-info {
      flex: 1;
      min-width: 0;
    }
    
    .user-info a {
      text-decoration: none;
      color: inherit;
    }
    
    .username {
      font-weight: 600;
      font-size: 14px;
      display: flex;
      align-items: center;
      gap: 4px;
    }
    
    .name {
      color: var(--color-text-secondary);
      font-size: 14px;
      margin-top: 2px;
    }
    
    .mutual {
      color: var(--color-text-secondary);
      font-size: 12px;
      margin-top: 4px;
    }
    
    .follow-btn {
      padding: 8px 16px;
      border-radius: 8px;
      font-weight: 600;
      font-size: 14px;
      cursor: pointer;
      border: none;
      transition: all 0.2s;
    }
    
    .follow-btn.primary {
      background: var(--color-primary);
      color: white;
    }
    
    .follow-btn.primary:hover {
      background: #1877f2;
    }
    
    .follow-btn.secondary {
      background: var(--color-bg-secondary);
      border: 1px solid var(--color-border);
      color: var(--color-text-primary);
    }
    
    .empty-state {
      text-align: center;
      padding: 60px 20px;
      color: var(--color-text-secondary);
    }
    
    .empty-state svg {
      width: 64px;
      height: 64px;
      margin-bottom: 16px;
    }
  </style>
</head>
<body>
  <%- include('partials/sidebar') %>
  <%- include('partials/modal') %>
  <%- include('partials/mobile-nav') %>

  <div class="main-content">
    <%- include('partials/top-nav') %>
    
    <div class="suggested-container">
      <div class="page-header">
        <h1>Suggested For You</h1>
        <p>People you might want to follow based on your connections</p>
      </div>
      
      <% if (suggested && suggested.length > 0) { %>
        <div class="suggested-list">
          <% suggested.forEach(u => { %>
            <div class="user-card" data-user-id="<%= u._id %>">
              <% if (u.avatar) { %>
                <img src="<%= u.avatar %>" alt="<%= u.username %>" class="user-avatar">
              <% } else { %>
                <div class="avatar-placeholder"><%= u.username.charAt(0).toUpperCase() %></div>
              <% } %>
              
              <div class="user-info">
                <a href="/user/<%= u._id %>">
                  <div class="username">
                    <%= u.username %>
                    <% if (u.isVerified) { %>
                      <svg aria-label="Verified" fill="#0095f6" height="12" viewBox="0 0 24 24" width="12">
                        <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"></path>
                      </svg>
                    <% } %>
                  </div>
                  <% if (u.name) { %>
                    <div class="name"><%= u.name %></div>
                  <% } %>
                </a>
                <% if (u.mutualCount > 0) { %>
                  <div class="mutual">Followed by <%= u.mutualCount %> connection<%= u.mutualCount > 1 ? 's' : '' %> you follow</div>
                <% } else { %>
                  <div class="mutual"><%= u.followers ? u.followers.length : 0 %> followers</div>
                <% } %>
              </div>
              
              <button class="follow-btn primary" onclick="toggleFollow('<%= u._id %>', this)">Follow</button>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <div class="empty-state">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
            <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
            <circle cx="8.5" cy="7" r="4"></circle>
            <line x1="20" y1="8" x2="20" y2="14"></line>
            <line x1="23" y1="11" x2="17" y2="11"></line>
          </svg>
          <h3>No suggestions yet</h3>
          <p>Follow more people to get personalized suggestions!</p>
        </div>
      <% } %>
    </div>
  </div>

  <%- include('partials/scripts') %>
</body>
</html>
