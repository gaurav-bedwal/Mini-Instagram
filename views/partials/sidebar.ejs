<div class="sidebar" id="sidebar">
    <a href="/" class="logo">Blogs</a>

    <a href="/" class="nav-item">
        <svg viewBox="0 0 24 24">
            <path
                d="M9.005 16.545a2.997 2.997 0 012.997-2.997h0a2.997 2.997 0 012.997 2.997v5.449c0 .412.333.746.746.746h3.253a2.997 2.997 0 002.997-2.997v-8.086c0-.528-.216-1.033-.598-1.398l-7.467-7.143a2.43 2.43 0 00-3.372 0l-7.467 7.143a1.995 1.995 0 00-.598 1.398v8.086c0 1.655 1.342 2.997 2.997 2.997h3.253a.746.746 0 00.746-.746v-5.449z"
                fill="currentColor"></path>
        </svg>
        <span>Home</span>
    </a>

    <a href="/search" class="nav-item">
        <svg viewBox="0 0 24 24">
            <path d="M19 10.5A8.5 8.5 0 1110.5 2a8.5 8.5 0 018.5 8.5z" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
            <line fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" x1="16.511" x2="22" y1="16.511" y2="22"></line>
        </svg>
        <span>Search</span>
    </a>

    <a href="/explore" class="nav-item">
        <svg viewBox="0 0 24 24">
            <polygon fill="none" points="13.941 13.953 7.581 16.424 10.06 10.056 16.42 7.585 13.941 13.953" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></polygon>
            <path d="M12 2.5a9.5 9.5 0 109.5 9.5 9.5 9.5 0 00-9.5-9.5z" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
        </svg>
        <span>Explore</span>
    </a>

    <a href="/stories" class="nav-item">
        <svg viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="2" stroke-dasharray="4 2"></circle>
            <circle cx="12" cy="12" r="4" fill="currentColor"></circle>
        </svg>
        <span>Stories</span>
    </a>

    <a href="/messages" class="nav-item">
        <svg viewBox="0 0 24 24">
            <path d="M22 3H2l10 9.5L22 3z" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
            <path d="M2 3v14c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
        <span>Messages</span>
    </a>

    <a href="/notifications" class="nav-item">
        <svg viewBox="0 0 24 24">
            <path d="M12 22c1.1 0 2-.9 2-2h-4c0 1.1.9 2 2 2zm6-6v-5c0-3.07-1.63-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.64 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2z" fill="currentColor"></path>
        </svg>
        <span>Notifications</span>
    </a>

    <a href="javascript:void(0)" class="nav-item create-btn" onclick="openModal()">
        <svg viewBox="0 0 24 24">
            <path
                d="M2 12c0 5.523 4.477 10 10 10s10-4.477 10-10S17.523 2 12 2 2 6.477 2 12zm10 5a1 1 0 01-1-1v-3H8a1 1 0 010-2h3V8a1 1 0 012 0v3h3a1 1 0 010 2h-3v3a1 1 0 01-1 1z"
                fill="currentColor"></path>
        </svg>
        <span>Create Post</span>
    </a>

    <a href="/saved" class="nav-item">
        <svg viewBox="0 0 24 24">
            <path d="M19 21l-7-5-7 5V5a2 2 0 012-2h10a2 2 0 012 2z" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
        </svg>
        <span>Saved</span>
    </a>

    <a href="/user/<%= user._id %>" class="nav-item">
        <svg viewBox="0 0 24 24">
            <path
                d="M12 2.5a5.5 5.5 0 105.5 5.5 5.506 5.506 0 00-5.5-5.5zm0 9a3.5 3.5 0 113.5-3.5 3.504 3.504 0 01-3.5 3.5zm7.394 6.136a8.52 8.52 0 00-14.788 0 .75.75 0 101.3.75 7.02 7.02 0 0112.188 0 .75.75 0 001.3-.75z"
                fill="currentColor"></path>
        </svg>
        <span>Profile</span>
    </a>

    <a href="/settings" class="nav-item">
        <svg viewBox="0 0 24 24">
            <path
                d="M19.336 10.1c.143.593.214 1.205.214 1.83a8.5 8.5 0 01-14.788 5.636 1 1 0 10-1.3 1.514A10.5 10.5 0 1021.55 11.93c0-.853-.087-1.686-.253-2.492a1 1 0 00-1.96.662zM12 7.5a4.5 4.5 0 11-4.5 4.5 4.5 4.5 0 014.5-4.5zm0 7a2.5 2.5 0 10-2.5-2.5 2.5 2.5 0 002.5 2.5z"
                fill="currentColor"></path>
        </svg>
        <span>Settings</span>
    </a>

    <% if (user && (user.role === 'admin' || user.role === 'moderator')) { %>
    <a href="/admin" class="nav-item" style="color: #0095f6;">
        <svg viewBox="0 0 24 24">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z" fill="currentColor"></path>
        </svg>
        <span>Admin</span>
    </a>
    <% } %>

    <div class="nav-item theme-toggle" onclick="toggleTheme()" style="cursor: pointer; margin-top: auto;">
        <svg id="sidebarThemeIconMoon" class="theme-icon-moon" viewBox="0 0 24 24">
            <path
                d="M21 12.75l-1.5 1.5-1.5-1.5M10.5 6A7.5 7.5 0 0018 13.5a7.512 7.512 0 004.14-1.233A9 9 0 1111.233 2.14 7.513 7.513 0 0010.5 6z"
                fill="currentColor"></path>
        </svg>
        <svg id="sidebarThemeIconSun" class="theme-icon-sun" viewBox="0 0 24 24">
            <path
                d="M12 7a5 5 0 105 5 5 5 0 00-5-5zm0 8a3 3 0 113-3 3 3 0 01-3 3zm0-13a1 1 0 00-1 1v1a1 1 0 002 0V3a1 1 0 00-1-1zm0 18a1 1 0 00-1 1v1a1 1 0 002 0v-1a1 1 0 00-1-1zm10-10h-1a1 1 0 000 2h1a1 1 0 000-2zM4 12H3a1 1 0 000 2h1a1 1 0 000-2zm14.05-7.05a1 1 0 10-1.414 1.414l.707.707a1 1 0 001.414-1.414zM7.05 18.05l-.707.707a1 1 0 001.414 1.414l.707-.707a1 1 0 00-1.414-1.414zm11.414 1.414a1 1 0 00-1.414-1.414l-.707.707a1 1 0 001.414 1.414zM7.05 5.95a1 1 0 101.414-1.414l-.707-.707a1 1 0 00-1.414 1.414z"
                fill="currentColor"></path>
        </svg>
        <span>Toggle Theme</span>
    </div>

    <a href="/logout" class="nav-item" style="color: #ed4956;">
        <svg viewBox="0 0 24 24">
            <path
                d="M10 2v2H5v16h5v2H3V2h7zm10.59 9l-4.29-4.3-1.42 1.42L17.17 11H8v2h9.17l-2.3 2.3 1.42 1.42 4.3-4.3-.01-.02.01-.02z"
                fill="currentColor"></path>
        </svg>
        <span>Logout</span>
    </a>
</div>